# Salin ke .env.local dan isi dengan nilai milik Anda. Jangan commit .env.local.
# Fitur AI (dinonaktifkan secara default).
# Ubah ENABLE_AI=true jika ingin mengaktifkan transkripsi dan saran AI.
ENABLE_AI=false

# Saran Efek AI (menggunakan OpenRouter atau OpenAI-compatible completions):
OPENROUTER_API_KEY=
OPENROUTER_SUGGESTION_MODEL=meta-llama/llama-3.3-70b-instruct

# Speech-to-Text (STT) Provider: "openrouter" atau "9router" (default: openrouter)
STT_PROVIDER=openrouter

# --- Opsi 1: Jika menggunakan 9Router untuk STT ---
# Endpoint default 9Router: http://127.0.0.1:20128/v1
# STT_BASE_URL=http://127.0.0.1:20128/v1
# STT_API_KEY=9router
# STT_MODEL=whisper-large-v3

# --- Opsi 2: Jika menggunakan OpenRouter untuk STT ---
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Bahasa audio yang dikirim ke speech-to-text (default: id)
STT_LANGUAGE=id
OPENROUTER_TRANSCRIPTION_LANGUAGE=id

# Direktori data lokal (default .data).
DATA_DIR=.data
# Batas ukuran unggahan dalam byte (default 2147483648 = 2 GiB).
MAX_UPLOAD_BYTES=2147483648

