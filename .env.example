# Salin ke .env.local dan isi dengan nilai milik Anda. Jangan commit .env.local.
# OpenRouter (opsional): tanpa key, transkripsi dan saran AI tidak tersedia.
OPENROUTER_API_KEY=
OPENROUTER_SUGGESTION_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=
# Bahasa audio yang dikirim ke speech-to-text.
OPENROUTER_TRANSCRIPTION_LANGUAGE=id
# Direktori data lokal (default .data).
DATA_DIR=.data
# Batas ukuran unggahan dalam byte (default 2147483648 = 2 GiB).
MAX_UPLOAD_BYTES=2147483648
