{
  "name": "moment-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"next dev --hostname 127.0.0.1 --port 3000\" \"tsx --env-file=.env.local src/worker/index.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "start": "concurrently -k \"next start --hostname 127.0.0.1 --port 3000\" \"tsx --env-file=.env.local src/worker/index.ts\"",
    "lint": "eslint",
    "doctor": "node scripts/doctor.mjs",
    "fixture": "node scripts/create-fixture.mjs",
    "smoke:render": "node scripts/smoke-render.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@remotion/bundler": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@twemoji/api": "^17.0.3",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "emoji-mart": "^5.6.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.4",
    "remotion": "4.0.535",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/busboy": "^1.5.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
